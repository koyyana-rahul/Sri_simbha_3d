# ==============================================================================
# Sri Simbha Ad Solutions — Backend Environment Variables
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# SMTP Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="Sri Simbha Ad Solutions <no-reply@srisimbha.com>"

# Receiver for customer campaign enquiries
ENQUIRY_RECEIVER=srisimbhaadsolutions.info@gmail.com
